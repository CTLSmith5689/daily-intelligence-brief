26","form":"8-K","doc_kind":"earnings_release","items":"2.02,9.01","accession":"0001045810-26-000073","collected":"2026-09-19","text_path":"text/NVDA/0001045810-26-000073.txt","text_chars":22352},{"filed":"2026-02-25","form":"10-K","doc_kind":"risk_factors","items":"1A","accession":"0001045810-26-000021-risk_factors","collected":"2026-09-19","text_path":"text/NVDA/0001045810-26-000021-risk_factors.txt","text_chars":42000},{"filed":"2026-02-25","form":"10-K","doc_kind":"business","items":"1","accession":"0001045810-26-000021-business","collected":"2026-09-19","text_path":"text/NVDA/0001045810-26-000021-business.txt","text_chars":26000}],"peer_share":{"group":"Semiconductors","n":59,"rank":1,"share":0.40457559162034074,"leader":"NVDA","leader_share":0.40457559162034074},"business":{"excerpt":"NVIDIA pioneered accelerated computing to help solve the most challenging computational problems. NVIDIA is now a data center scale AI infrastructure company reshaping all industries. Our technology stack includes the foundational NVIDIA CUDA development platform that runs on all NVIDIA GPUs, as well as hundreds of domain-specific software libraries, frameworks, algorithms, software development kits, or SDKs, and application programming interfaces, or APIs. This deep and broad software stack accelerates the performance and facilitates the deployment of NVIDIA accelerated computing for computationally intensive workloads such as artificial intelligence, or AI, model training and inference, data analytics, scientific computing, robotics, and 3D graphics, with vertical-specific optimizations to address industries ranging from healthcare and telecom to automotive and manufacturing.","filed":"2026-02-25","text_path":"text/NVDA/0001045810-26-000021-business.txt","text_chars":26000}}